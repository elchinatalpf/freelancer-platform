{
  "name": "freelancer-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "APP_URL=http://dummy.invalid next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "APP_URL=http://dummy.invalid knip",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:e2e": "playwright test",
    "test:mutation": "stryker run",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm knip && pnpm test:unit"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "knip": "6.48.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
