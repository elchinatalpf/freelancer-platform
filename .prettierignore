# Prettier keeps its defaults. It also skips everything .gitignore lists.

# Markdown: Prettier would re-pad the ADR index table, collapse the aligned
# Layout columns in CLAUDE.md, and reformat the code in docs/Agent kit.md that
# must match .claude/ byte for byte.
*.md

# Protected paths. `pnpm format` writes through the shell, where the
# protect-paths hook cannot stop it.
/.claude/
/tests/security/

# Generated by pnpm.
/pnpm-lock.yaml
# Owner-guarded supply-chain settings: a reformat must never hide a real change.
/pnpm-workspace.yaml

# Tool output, at the root only.
/.vitest/
/.stryker-tmp/
/reports/
/test-results/
/playwright-report/
